# Copiar este archivo como .env y ajustar los valores
# Es opcional: sin .env se usan los valores por defecto de app/config.py.

# Puerto HTTP del servidor. Si lo cambias, cambia tambien el proxy de frontend/vite.config.ts
PORT=8000

# Base de datos (por defecto: SQLite en backend/llavetrack.db)
# DATABASE_URL=sqlite:///llavetrack.db

# Minutos que tiene el docente para retirar la llave con su codigo
RESERVA_MINUTOS=10

# TEMPORAL hasta el login (Fase 2): permite indicar el usuario con el
# encabezado X-Usuario-Email. Nunca activarlo en la demo.
MODO_DESARROLLO=true

# Segundos minimos que se extiende la reserva cuando el equipo acepta el codigo
RETIRO_MARGEN_SEGUNDOS=120

# Broker MQTT. Usuario y clave vacios = anonimo (desarrollo)
MQTT_HABILITADO=true
MQTT_HOST=localhost
MQTT_PUERTO=1883
# MQTT_USUARIO=
# MQTT_CLAVE=

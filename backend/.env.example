# Copiar este archivo como .env y ajustar los valores
# Es opcional: sin .env se usan los valores por defecto de app/config.py.

# Puerto HTTP del servidor. Si lo cambias, cambia tambien el proxy de frontend/vite.config.ts
PORT=8000

# Base de datos (por defecto: SQLite en backend/llavetrack.db)
# DATABASE_URL=sqlite:///llavetrack.db
# Supabase: en el dashboard, boton "Connect" > "Session pooler" (puerto 5432, no el 6543).
# Cambiar "postgresql://" por "postgresql+psycopg://" y poner la clave de la base.
# Compartida por todo el grupo: para desarrollar conviene SQLite local.
# DATABASE_URL=postgresql+psycopg://postgres.njdagfhwhtppqpypagzx:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Minutos que tiene el docente para retirar la llave con su codigo
RESERVA_MINUTOS=10

# Segundos minimos que se extiende la reserva cuando el equipo acepta el codigo
RETIRO_MARGEN_SEGUNDOS=120

# Broker MQTT. Usuario y clave vacios = anonimo (desarrollo)
MQTT_HABILITADO=true
MQTT_HOST=localhost
MQTT_PUERTO=1883
# MQTT_USUARIO=
# MQTT_CLAVE=

# Segundos sin ningun mensaje del equipo (manda un latido cada 30 s) para darlo por desconectado.
# Con el equipo desconectado no se pueden pedir llaves (US-20)
EQUIPO_TIMEOUT_SEGUNDOS=90

# Login: minutos sin actividad hasta que se cierra la sesion, y bloqueo por intentos fallidos
SESION_MINUTOS=15
LOGIN_INTENTOS_MAX=5
LOGIN_BLOQUEO_MINUTOS=15
# true solo si la web se sirve por HTTPS (en la demo con dominio)
COOKIE_SEGURA=false

# Recuperacion de contrasena: el link del mail vence en estos minutos
RECUPERACION_MINUTOS=30
# Direccion de la web, para armar el link del mail (desde el celular: http://<IP>:5173)
WEB_URL=http://localhost:5173
# Mail saliente. Sin SMTP_HOST no se manda nada y el link aparece en la consola del servidor.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=587 y una "contrasena de aplicacion"
# SMTP_HOST=
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_REMITENTE=
